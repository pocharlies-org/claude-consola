#!/usr/bin/env bash
# statusLine de Claude Code: etiqueta del modelo + los segmentos de las píldoras de Paseo. Cada segmento falla en
# silencio: sin dato, sin segmento. La barra no sondea nada: pinta lo que dejan los eventos en $ESTADO.
#   TTL  — lo escribe el hook Stop (console/ttl-stop.ts) una vez por turno. 🟣 local 🟢 >5min 🟡 ≤5min 🔴 sin caché
#   🌙   — descuento nocturno Alibaba (22:00–08:00 UTC+8), solo con modelo alibaba-*: reloj puro, sin E/S
#   CI   — checks del PR abierto de la rama actual del cwd: el vigía los relee con cada evento de GitHub del bus
#   CD   — ArgoCD (por defecto) o Flux si el repo del cwd lleva "flux" en el nombre: el watch del vigía
input=$(cat)
if command -v jq >/dev/null 2>&1; then
  sid=$(printf '%s' "$input" | jq -r '.session_id // ""')
  id=$(printf '%s' "$input" | jq -r '.model.id // ""')
  name=$(printf '%s' "$input" | jq -r '.model.display_name // .model.id // "?"')
  dir=$(printf '%s' "$input" | jq -r '.workspace.current_dir // empty')
else
  sid=""; id=""; name="?"; dir=""
fi
re='^(qwen|tooling|or-|alibaba-|q38-|litellm/)'
shopt -s nocasematch
if [[ $id =~ $re ]]; then
  tag="🟢 LOCAL"
else
  tag="🔵 ANTHROPIC"
fi

ESTADO=${XDG_CACHE_HOME:-$HOME/.cache}/claude-consola/${HOSTNAME:-$(hostname)}  # por host: el home puede ser compartido
d=$(mktemp -d); trap 'rm -rf "$d"' EXIT

# El vigía (console/vigia.py, uno por host) es el único que lee el clúster y el bus. Si no vive se arranca suelto y la
# barra sigue: esta vuelta sin CI/CD, la siguiente ya con lo que él haya escrito.
# El pid se comprueba por su comando: el fichero sobrevive a un reinicio del host y ese número puede ser ya otro proceso
# (un editor con vigia.py abierto, por ejemplo: por eso tiene que ser python).
vigia=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/console/vigia.py
pid=$(cat "$ESTADO/vigia.pid" 2>/dev/null)
case $(ps -p "${pid:-0}" -o args= 2>/dev/null) in
  *python*console/vigia.py*) ;;
  *) pid=; ! command -v python3 >/dev/null || ( cd / && nohup python3 "$vigia" >/dev/null 2>&1 & ) ;;
esac

# TTL: lo deja el hook Stop una vez por turno (console/ttl-stop.ts); aquí solo se cuenta atrás, sin red.
(
  [ -n "$sid" ] && read -r plan expira < "$ESTADO/ttl/$sid" 2>/dev/null || exit 0
  [ "$expira" != - ] && base=$(( expira - $(date +%s) )) || base=0
  [ "$base" -gt 0 ] || { printf '🔴 —'; exit 0; }
  m=$(( (base + 30) / 60 ))
  [ "$m" -lt 60 ] && lab="${m}m" || lab="$((m/60))h $((m%60))m"
  if [ "$plan" = local ]; then tono=🟣
  elif [ "$base" -le 300 ]; then tono=🟡
  else tono=🟢; fi
  printf '%s %s' "$tono" "$lab"
) > "$d/ttl" 2>/dev/null &

# Descuento Alibaba (ventana y % de la píldora paseo-descuento; hora de facturación UTC+8)
(
  [[ $id == alibaba-* ]] || exit 0
  pct=; [[ $id =~ (ds|deepseek) ]] && pct=50
  [ -z "$pct" ] && [[ $id =~ (q3[78]|qwen) ]] && pct=40
  [ -n "$pct" ] || exit 0
  t8=$(( $(date +%s) + 28800 )); h=$(( t8 / 3600 % 24 ))
  if [ "$h" -ge 22 ] || [ "$h" -lt 8 ]; then
    left=$(( (t8/86400*86400 + 8*3600 + (h<8?0:86400)) - t8 ))
    printf '🌙 -%s%% quedan %sh %sm' "$pct" $((left/3600)) $(( (left%3600+59)/60 ))
  else
    left=$(( t8/86400*86400 + 22*3600 - t8 + (h<22?0:86400) ))
    printf '🌙 en %sh' $(( (left+1800)/3600 ))
  fi
) > "$d/desc" 2>/dev/null &

# CI del PR de la rama actual (solo en repo git con PR abierto). La lee el vigía: la primera vez cuando la barra le avisa
# de que mira esta rama (SIGUSR1) y desde ahí con cada evento de GitHub de ese repo. Sin bus no hay CI: no se sondea.
(
  read -r bus _ < "$ESTADO/ci.estado" 2>/dev/null && [ "$bus" = ok ] || exit 0
  [ -n "$dir" ] && git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0
  br=$(git -C "$dir" branch --show-current) && [ -n "$br" ] || exit 0  # HEAD separado: no hay rama ni PR propia
  repo=$(sed -E 's#\.git$##; s#^.+[:/]([^/]+/[^/]+)$#\1#' <<<"$(git -C "$dir" config --get remote.origin.url)")
  key=$ESTADO/ci/$(md5sum <<<"$repo/$br" | cut -c1-8)
  printf '%s %s\n' "$repo" "$br" > "$key.rama"  # lo que el vigía relee; cada repintado lo mantiene vivo
  [ -s "$key" ] || { [ -z "$pid" ] || kill -USR1 "$pid"; exit 0; }
  [ "$(jq -r '.[0].state // ""' "$key")" = OPEN ] || exit 0
  n=$(jq -r '.[0].number' "$key")
  rollup=$(jq '[.[0].statusCheckRollup[] | (.status // .state // "") | ascii_upcase |
    if . == "SUCCESS" or . == "COMPLETED" or . == "NEUTRAL" or . == "SKIPPED" or . == "SUCCESSFUL" then "ok"
    elif . == "PENDING" or . == "EXPECTED" or . == "QUEUED" or . == "IN_PROGRESS" or . == "INPROGRESS" or . == "WAITING" or . == "REQUESTED" then "pend"
    else "fail" end] | group_by(.) | map({(.[0]): length}) | add // {}' "$key")
  f=$(jq -r '.fail // 0' <<<"$rollup"); p=$(jq -r '.pend // 0' <<<"$rollup")
  if [ "$f" != 0 ]; then t=🔴; elif [ "$p" != 0 ]; then t=🟡; else t=🟢; fi
  printf '%s CI #%s' "$t" "$n"
) > "$d/ci" 2>/dev/null &

# CD de la app cuyo origen es el repo del cwd: Flux si el repo lleva "flux", ArgoCD en cualquier otro caso. Lo escribe el
# watch del vigía. Dos ausencias distintas: watch caído (🟡 <motor> sin conexión) y ninguna app que coincida (silencio).
(
  [ -n "$dir" ] || exit 0
  url=$(git -C "$dir" remote get-url origin 2>/dev/null) || exit 0
  repo=$(sed -E 's#\.git$##; s#^.+[:/]([^/]+/[^/]+)$#\1#' <<<"$url")
  case $repo in *flux*) motor=flux ;; *) motor=argocd ;; esac
  read -r est _ < "$ESTADO/cd-$motor.estado" 2>/dev/null || exit 0
  case "$est" in
    ok) ;;
    caido) printf '🟡 %s sin conexión' "$motor"; exit 0 ;;
    *) exit 0 ;; # sin cliente del clúster o el clúster no sirve ese motor
  esac
  IFS=$'\t' read -r _ app state < <(awk -F'\t' -v r="$repo" 'tolower($1) ~ tolower(r) "(\\.git)?$" { print; exit }' \
    "$ESTADO/cd-$motor" 2>/dev/null) || exit 0 # ninguna app de este repo: sin segmento
  if [ "$motor" = flux ]; then
    case "$state" in
      True) printf '🟢 %s Ready' "$app" ;;
      False) printf '🔴 %s Failed' "$app" ;;
      *) printf '🟡 %s Unknown' "$app" ;;
    esac
  else
    case "$state" in
      Synced/Healthy) printf '🟢 %s %s' "$app" "$state" ;;
      *Degraded*|*Error*|*Failed*) printf '🔴 %s %s' "$app" "$state" ;;
      *) printf '🟡 %s %s' "$app" "$state" ;;
    esac
  fi
) > "$d/cd" 2>/dev/null &

wait
segs=""
for s in ttl desc ci cd; do v=$(<"$d/$s"); [ -n "$v" ] && segs+="  ·  $v"; done
printf '%s  ·  %s%s%s' "$tag" "$name" "${dir:+  ·  ${dir##*/}}" "$segs"
